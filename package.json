{
  "name": "train-booking-system",
  "version": "0.1.0",
  "private": true,
  "description": "Train transportation platform — application foundation and relational database",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "start:server": "npm run start --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:deploy": "npm run db:deploy --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:verify": "npm run db:verify --workspace server",
    "test:db": "npm run test:db --workspace server",
    "test:auth": "npm run test:auth --workspace server",
    "test:admin": "npm run test:admin --workspace server",
    "test:search": "npm run test:search --workspace server",
    "test:recommendation": "npm run test:recommendation --workspace server",
    "test:booking": "npm run test:booking --workspace server",
    "test:payment": "npm run test:payment --workspace server",
    "auth:secret": "npm run auth:secret --workspace server",
    "test:ticket": "npm run test:ticket --workspace server",
    "test:officer": "npm run test:officer --workspace server"
  },
  "overrides": {
    "mariadb": "3.5.4",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
