NODE_ENV=development
HOST=localhost
PORT=5000
# Comma-separated browser origins; no paths or trailing slashes.
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Use a dedicated development database. URL-encode special password characters.
DATABASE_URL=mysql://railconnect:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/railconnect_demo
# Trusted MySQL RSA public key for caching_sha2_password on a local non-TLS connection.
# Paths are relative to server/. For this workspace: ../.local/mysql/data/public_key.pem
DATABASE_RSA_PUBLIC_KEY_PATH=
# Required only by migrate dev; must be a separate, disposable database.
SHADOW_DATABASE_URL=mysql://railconnect:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/railconnect_shadow
# Explicit opt-in for demonstration seeding. Set only for a development database.
ALLOW_DEMO_SEED=true
ALLOW_DB_TESTS=false
# Local demo seed only: minimum 8 characters, maximum 72 UTF-8 bytes.
# Public registration uses stronger validation. Seeding preserves existing hashes.
DEMO_ADMIN_PASSWORD=
DEMO_OFFICER_PASSWORD=
DEMO_PASSENGER_PASSWORD=
# Set on initial seed, e.g. 2026-09-20. Reruns retain existing schedule dates.
DEMO_START_DATE=
# Generate locally with npm run auth:secret. Never commit the actual secret.
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Academic demo only: no real gateway or banking credentials.
DEMO_PAYMENTS_ENABLED=true
# SUCCESS, FAILURE or FAIL_THEN_SUCCESS; the backend decides every result.
DEMO_PAYMENT_SCENARIO=SUCCESS
