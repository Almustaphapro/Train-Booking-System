NODE_ENV=development
HOST=localhost
PORT=5000
# Comma-separated browser origins; no paths or trailing slashes.
CLIENT_URL=http://localhost:5173,http://localhost:4173
# Use a dedicated development database. URL-encode special password characters.
DATABASE_URL=mysql://railconnect:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/railconnect_demo
# Required only by migrate dev; must be a separate, disposable database.
SHADOW_DATABASE_URL=mysql://railconnect:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/railconnect_shadow
# Explicit opt-in for demonstration seeding. Set only for a development database.
ALLOW_DEMO_SEED=true
DEMO_ADMIN_PASSWORD=
DEMO_OFFICER_PASSWORD=
DEMO_PASSENGER_PASSWORD=
# Set on initial seed, e.g. 2026-09-20. Reruns retain existing schedule dates.
DEMO_START_DATE=
